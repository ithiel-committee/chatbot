################################################################################
# 環境変数設定ファイル (.env.example)
################################################################################
#
# 【目次】
# 1. 基本設定 (言語・背景・画面表示)
# 2. キャラクター設定 (名前・VRMモデル・システムプロンプト)
# 3. AI・LLM設定 (AIサービス選択・モデル・APIキー)
# 4. 音声合成設定 (VOICEVOX)
# 5. 音声入力設定 (ブラウザ音声認識)
# 6. システム・サーバー設定
#
################################################################################

#===============================================================================
# 1. 基本設定
#===============================================================================

# デフォルト言語の設定 (ja: 日本語, en: 英語)
NEXT_PUBLIC_SELECT_LANGUAGE="ja"

# 背景画像のパス（public/backgrounds/ 配下のファイル名）
NEXT_PUBLIC_BACKGROUND_IMAGE_PATH="/backgrounds/bg.jpg"

# 回答欄の表示設定（true/false）
NEXT_PUBLIC_SHOW_ASSISTANT_TEXT="true"

# 回答欄のスタイル（bubble: ガラスバブル, borderless: 縁無し字幕風）
NEXT_PUBLIC_ASSISTANT_TEXT_STYLE="borderless"

# キャラクター名表示設定（true/false）
NEXT_PUBLIC_SHOW_CHARACTER_NAME="true"

# 操作パネル表示設定（true/false）
NEXT_PUBLIC_SHOW_CONTROL_PANEL="true"

# 入力フォーム表示設定（true/false）
NEXT_PUBLIC_SHOW_INPUT_FORM="true"


#===============================================================================
# 2. キャラクター設定
#===============================================================================

# キャラクター名
NEXT_PUBLIC_CHARACTER_NAME="イティエル"

# ユーザー表示名
NEXT_PUBLIC_USER_DISPLAY_NAME="あなた"

# 使用するモデルタイプ（vrm）
NEXT_PUBLIC_MODEL_TYPE="vrm"

# 選択するVRMモデルのパス（public/vrm/ 配下のファイル名）
NEXT_PUBLIC_SELECTED_VRM_PATH="/vrm/ithiel.vrm"

# システムプロンプト（キャラクターの人格・口調・設定）
NEXT_PUBLIC_SYSTEM_PROMPT="あなたは中央大学国際情報学部(iTL)のマスコットキャラクター「イティエル」です。丁寧で明るい口調で会話してください。"


#===============================================================================
# 3. AI・LLM設定
#===============================================================================

# AIサービスの選択
# google, openai, anthropic, openrouter, azure, groq, lmstudio, ollama, dify
NEXT_PUBLIC_SELECT_AI_SERVICE="google"

# 選択するAIモデル名（例: gemini-3.8-flash, gpt-4o, gpt-4o-mini 等）
NEXT_PUBLIC_SELECT_AI_MODEL="gemini-3.8-flash"

# 会話のランダム性を調整する温度パラメータ（0.0～2.0）
NEXT_PUBLIC_TEMPERATURE=0.7

# 過去の会話メッセージ保持数
NEXT_PUBLIC_MAX_PAST_MESSAGES=10

# サーチグラウンディング（Web検索連携）機能（true/false）
NEXT_PUBLIC_USE_SEARCH_GROUNDING="false"

# --- 各種LLM APIキー ---
# ※ 後述の AITUBERKIT_SERVER_SECRET_ACCESS_MODE="unprotected" を有効にすることで、
# ブラウザ側での入力不要でサーバー側から安全にAPIキーが使用されます。

# Google Gemini API キー (GEMINI_API_KEY または GOOGLE_API_KEY)
GEMINI_API_KEY=""
GOOGLE_API_KEY=""

# OpenAI API キー
OPENAI_API_KEY=""

# OpenRouter API キー
OPENROUTER_API_KEY=""

# Anthropic (Claude) API キー
ANTHROPIC_API_KEY=""

# ローカルLLM URL (Ollama 等を使用する場合)
NEXT_PUBLIC_LOCAL_LLM_URL=""


#===============================================================================
# 4. 音声合成設定 (TTS)
#===============================================================================

# 使用する音声合成エンジン (voicevox)
NEXT_PUBLIC_SELECT_VOICE="voicevox"

# VOICEVOX サーバーURL
VOICEVOX_SERVER_URL="http://localhost:50021"
NEXT_PUBLIC_VOICEVOX_SERVER_URL="http://localhost:50021"

# VOICEVOX 話者ID (キャラクターに合わせて設定)
NEXT_PUBLIC_VOICEVOX_SPEAKER="46"

# 話速 (1.0 = 標準)
NEXT_PUBLIC_VOICEVOX_SPEED="1.0"

# 音高 (0.0 = 標準)
NEXT_PUBLIC_VOICEVOX_PITCH="0.0"

# 抑揚 (1.0 = 標準)
NEXT_PUBLIC_VOICEVOX_INTONATION="1.0"


#===============================================================================
# 5. 音声入力設定 (STT)
#===============================================================================

# 音声認識モード (browser: ブラウザ標準 Web Speech API, whisper: OpenAI Whisper)
NEXT_PUBLIC_SPEECH_RECOGNITION_MODE="browser"


#===============================================================================
# 6. システム・サーバー設定
#===============================================================================

# サーバー側秘匿キーの利用制限 (unprotected: 制限なし・ローカル開発や展示推奨)
AITUBERKIT_SERVER_SECRET_ACCESS_MODE="unprotected"

# ページリロード時に常に環境変数を優先する設定（true/false）
NEXT_PUBLIC_ALWAYS_OVERRIDE_WITH_ENV_VARIABLES="true"
