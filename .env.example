################################################################################
# 環境変数設定ファイル (.env.example)
################################################################################
#
# 【概要】
# 本リポジトリは「iThiel Committee」と「C3」等の複数プロジェクトで共有する
# 構成となっています。プロジェクト固有の名称・モデル・プロンプト等は
# プレースホルダーとして定義されています。
#
# 【目次】
# 1. アプリケーション情報 (サイト名・タイトル・説明文)
# 2. 画面・表示設定 (言語・背景・表示スタイル)
# 3. キャラクター設定 (名前・モデル・システムプロンプト)
# 4. AI・LLM設定 (AIサービス・モデル・APIキー)
# 5. 音声合成設定 (TTS / VOICEVOX)
# 6. 音声入力設定 (STT / ブラウザ音声認識)
# 7. システム・サーバー設定
# 8. プロジェクト別設定例 (iThiel / C3)
#
################################################################################


#===============================================================================
# 1. アプリケーション情報
#===============================================================================

# アプリケーション名
NEXT_PUBLIC_SITE_NAME="<アプリ名>"

# ブラウザタブのタイトル
NEXT_PUBLIC_SITE_TITLE="<ブラウザタブのタイトル>"

# サイト・アプリの説明文 (メタタグ用)
NEXT_PUBLIC_SITE_DESCRIPTION="<アプリの説明文>"

# 「このアプリについて」ダイアログに表示する紹介文
NEXT_PUBLIC_ABOUT_DESCRIPTION="<「このアプリについて」の紹介文>"


#===============================================================================
# 2. 画面・表示設定
#===============================================================================

# デフォルト言語の設定 (ja: 日本語, en: 英語)
NEXT_PUBLIC_SELECT_LANGUAGE="ja"

# 背景画像のパス (public/backgrounds/ 配下のファイルパス)
NEXT_PUBLIC_BACKGROUND_IMAGE_PATH="/backgrounds/bg.jpg"

# 回答欄の表示設定 (true/false)
NEXT_PUBLIC_SHOW_ASSISTANT_TEXT="true"

# 回答欄のスタイル (bubble: ガラスバブル, borderless: 縁無し字幕風)
NEXT_PUBLIC_ASSISTANT_TEXT_STYLE="borderless"

# キャラクター名表示設定 (true/false)
NEXT_PUBLIC_SHOW_CHARACTER_NAME="true"

# 操作パネル表示設定 (true/false)
NEXT_PUBLIC_SHOW_CONTROL_PANEL="true"

# 入力フォーム表示設定 (true/false)
NEXT_PUBLIC_SHOW_INPUT_FORM="true"


#===============================================================================
# 3. キャラクター設定
#===============================================================================

# キャラクター名
NEXT_PUBLIC_CHARACTER_NAME="<キャラクター名>"

# ユーザー表示名
NEXT_PUBLIC_USER_DISPLAY_NAME="あなた"

# 使用するモデルタイプ (vrm / live2d / pngtuber)
NEXT_PUBLIC_MODEL_TYPE="vrm"

# 選択するVRMモデルのパス (public/vrm/ 配下のファイルパス)
NEXT_PUBLIC_SELECTED_VRM_PATH="/vrm/<モデルファイル名>.vrm"

# システムプロンプト (キャラクターの人格・役割・口調設定)
NEXT_PUBLIC_SYSTEM_PROMPT="<システムプロンプト (例: あなたは〇〇です。丁寧で明るい口調で会話してください。)>"

# 定型応答機能の有効化 (true: キーワード一致時に固定定型文を即時返答 / false: 常にAIが回答)
NEXT_PUBLIC_ENABLE_CANNED_RESPONSES="false"


#===============================================================================
# 4. AI・LLM設定
#===============================================================================

# AIサービスの選択
# google, openai, anthropic, openrouter, azure, groq, lmstudio, ollama, dify
NEXT_PUBLIC_SELECT_AI_SERVICE="google"

# 選択するAIモデル名 (例: gemini-3.8-flash, gpt-4o, llama3 等)
NEXT_PUBLIC_SELECT_AI_MODEL="gemini-3.8-flash"

# 会話のランダム性を調整する温度パラメータ (0.0～2.0)
NEXT_PUBLIC_TEMPERATURE=0.7

# 過去の会話メッセージ保持数
NEXT_PUBLIC_MAX_PAST_MESSAGES=10

# サーチグラウンディング (Web検索連携) 機能 (true/false)
NEXT_PUBLIC_USE_SEARCH_GROUNDING="false"

# --- 各種LLM APIキー ---
# ※ 後述の AITUBERKIT_SERVER_SECRET_ACCESS_MODE="unprotected" を有効にすることで、
# ブラウザ側での入力不要でサーバー側から安全にAPIキーが使用されます。

# Google Gemini API キー (GEMINI_API_KEY または GOOGLE_API_KEY)
GEMINI_API_KEY=""
GOOGLE_API_KEY=""

# OpenAI API キー
OPENAI_API_KEY=""

# OpenRouter API キー
OPENROUTER_API_KEY=""

# Anthropic (Claude) API キー
ANTHROPIC_API_KEY=""

# ローカルLLM URL (Ollama や LM Studio を使用する場合)
NEXT_PUBLIC_LOCAL_LLM_URL=""


#===============================================================================
# 5. 音声合成設定 (TTS)
#===============================================================================

# 使用する音声合成エンジン (voicevox)
NEXT_PUBLIC_SELECT_VOICE="voicevox"

# VOICEVOX サーバーURL
VOICEVOX_SERVER_URL="http://localhost:50021"
NEXT_PUBLIC_VOICEVOX_SERVER_URL="http://localhost:50021"

# VOICEVOX 話者ID (キャラクターに合わせて設定)
NEXT_PUBLIC_VOICEVOX_SPEAKER="46"

# 話速 (1.0 = 標準)
NEXT_PUBLIC_VOICEVOX_SPEED="1.0"

# 音高 (0.0 = 標準)
NEXT_PUBLIC_VOICEVOX_PITCH="0.0"

# 抑揚 (1.0 = 標準)
NEXT_PUBLIC_VOICEVOX_INTONATION="1.0"


#===============================================================================
# 6. 音声入力設定 (STT)
#===============================================================================

# 音声認識モード (browser: ブラウザ標準 Web Speech API, whisper: OpenAI Whisper)
NEXT_PUBLIC_SPEECH_RECOGNITION_MODE="browser"


#===============================================================================
# 7. システム・サーバー設定
#===============================================================================

# サーバー側秘匿キーの利用制限 (unprotected: 制限なし・ローカル開発や展示推奨)
AITUBERKIT_SERVER_SECRET_ACCESS_MODE="unprotected"

# ページリロード時に常に環境変数を優先する設定 (true/false)
NEXT_PUBLIC_ALWAYS_OVERRIDE_WITH_ENV_VARIABLES="true"


#===============================================================================
# 8. プロジェクト別設定例 (プリセット)
#===============================================================================
# 以下の設定例をコピーして上記の各変数に上書き設定することで、
# 各プロジェクトの構成へ即座に切り替えることができます。
#
# -----------------------------------------------------------------------------
# 【プロジェクト例 1: iThiel Committee (イティエル)】
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_NAME="iThieL Chatbot"
# NEXT_PUBLIC_SITE_TITLE="iThieL Chatbot｜中央大学国際情報学部(iTL) AIキャラクター対話システム"
# NEXT_PUBLIC_SITE_DESCRIPTION="iThieL Chatbotは、中央大学国際情報学部(iTL)のAIキャラクター「イティエル」とリアルタイムに対話・相談ができるWebアプリケーションです。"
# NEXT_PUBLIC_ABOUT_DESCRIPTION="iThieL Chatbotでは、Webブラウザだけで中央大学国際情報学部（iTL）のAIキャラクター「イティエル」との会話を楽しめます。"
# NEXT_PUBLIC_CHARACTER_NAME="イティエル"
# NEXT_PUBLIC_SELECTED_VRM_PATH="/vrm/ithiel.vrm"
# NEXT_PUBLIC_SYSTEM_PROMPT="あなたは中央大学国際情報学部(iTL)のマスコットキャラクター「イティエル」です。丁寧で明るい口調で会話してください。"
# NEXT_PUBLIC_ENABLE_CANNED_RESPONSES="true"
# NEXT_PUBLIC_SELECT_AI_SERVICE="google"
# NEXT_PUBLIC_SELECT_AI_MODEL="gemini-3.8-flash"
# NEXT_PUBLIC_SELECT_VOICE="voicevox"
# NEXT_PUBLIC_VOICEVOX_SPEAKER="46"
#
# -----------------------------------------------------------------------------
# 【プロジェクト例 2: C3 (ホログラム対話システム)】
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_NAME="C3 Chatbot"
# NEXT_PUBLIC_SITE_TITLE="C3 Chatbot｜AI対話システム"
# NEXT_PUBLIC_SITE_DESCRIPTION="C3プロジェクトのホログラム対話システムです。"
# NEXT_PUBLIC_ABOUT_DESCRIPTION="C3ホログラムデバイス向けのAI対話システムです。"
# NEXT_PUBLIC_CHARACTER_NAME="アシスタント"
# NEXT_PUBLIC_SELECTED_VRM_PATH="/vrm/AvatarSample_A.vrm"
# NEXT_PUBLIC_SYSTEM_PROMPT="あなたは親切なAIアシスタントです。質問に対して簡潔にわかりやすく回答してください。"
# NEXT_PUBLIC_ENABLE_CANNED_RESPONSES="false"
# NEXT_PUBLIC_SELECT_AI_SERVICE="ollama"
# NEXT_PUBLIC_SELECT_AI_MODEL="llama3"
# NEXT_PUBLIC_LOCAL_LLM_URL="http://localhost:11434/v1"
# NEXT_PUBLIC_SELECT_VOICE="voicevox"
# NEXT_PUBLIC_VOICEVOX_SPEAKER="1"
